{
  "name": "formulacms-starter",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formulacms/formulacms-starter.git"
  },
  "bugs": {
    "url": "https://github.com/formulacms/formulacms-starter/issues"
  },
  "homepage": "https://github.com/formulacms/formulacms-starter#readme",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22",
    "pnpm": "11.x"
  },
  "scripts": {
    "build": "next build --webpack",
    "start": "pnpm start:local",
    "dev": "convex dev --start \"pnpm dev:frontend\"",
    "dev:frontend": "tsx scripts/start-next-dev.ts",
    "dev:dashboard": "convex dashboard",
    "restart": "sh scripts/restart.sh",
    "stop:all": "lsof -ti:3210 -ti:3000 -ti:3333 | xargs kill -9 2>/dev/null",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint . --ignore-pattern \"convex/_generated/**\"",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:gate": "tsc --noEmit",
    "doctor": "react-doctor --no-telemetry",
    "mcp:catalog": "tsx scripts/mcp-catalog-server.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "content-types:sync": "tsx scripts/sync-content-type-registration.ts",
    "slices:sync": "node --import tsx scripts/sync-slice-registration.ts",
    "slices:author": "node --import tsx scripts/author-slices.ts",
    "check:slices:narrowed-profile": "node scripts/check-narrowed-slice-profile.mjs --exclude contact-form --exclude site-search --exclude cta-band",
    "check:release-identity": "tsx scripts/check-release-identity.ts",
    "check:release-provenance": "tsx scripts/check-release-provenance.ts",
    "check:token-boundary": "node --import tsx scripts/check-token-boundary.ts",
    "check:token-contrast": "node --import tsx scripts/check-public-token-contrast.ts",
    "check:tokens": "npm-run-all check:token-boundary check:token-contrast",
    "check:public:images": "node --import tsx scripts/check-next-image-config.ts",
    "check:public:routing": "node scripts/check-public-routing-production.mjs",
    "check:public": "npm-run-all check:public:images",
    "check:pilot-envelope": "tsx scripts/check-bounded-pilot-envelope.ts",
    "check:pilot-envelope:capacity": "tsx scripts/check-bounded-pilot-envelope.ts --capacity-alert",
    "check:e2e": "tsx scripts/verify-starter-e2e.ts",
    "check:e2e:specs": "playwright test --config=playwright.config.ts --project=non-disposable",
    "check:e2e:specs:disposable": "playwright test --config=playwright.config.ts --project=disposable",
    "build:local": "NEXT_PUBLIC_SITE_URL=http://localhost:3000 pnpm build",
    "start:local": "convex dev --tail-logs disable --start \"BETTER_AUTH_URL=http://localhost:3000 NEXT_PUBLIC_SITE_URL=http://localhost:3000 FORMULACMS_ALLOW_LOCAL_IMAGE_IPS=1 pnpm exec next start -p 3000\"",
    "start:deploy": "pnpm exec next start",
    "check:preflight": "tsx scripts/check-starter-preflight.ts",
    "check:preflight:strict": "tsx scripts/check-starter-preflight.ts --strict",
    "check:app-creation:routes": "tsx scripts/verify-app-creation.ts",
    "check:app-creation": "PUBLIC_BASE_URL=http://localhost:3000 npm-run-all check:preflight check:public:images check:e2e check:app-creation:routes",
    "check:app-creation:feedback": "tsx scripts/summarize-starter-feedback.ts",
    "check:app-creation:report": "tsx scripts/run-app-creation-report.ts",
    "check:e2e:local": "PUBLIC_BASE_URL=http://localhost:3000 pnpm check:e2e",
    "test:reduced-selection": "vitest run convex/reducedSelection.runtime.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/openai": "^4.0.109",
    "@convex-dev/action-retrier": "^0.3.1",
    "@convex-dev/better-auth": "^0.13.0",
    "@convex-dev/migrations": "^0.3.7",
    "@convex-dev/rate-limiter": "^0.4.3",
    "@convex-dev/workpool": "0.4.15",
    "@hookform/resolvers": "^6.0.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@opencoredev/email-sdk": "3.0.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-horizontal-rule": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-strike": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-table-cell": "3.32.0",
    "@tiptap/extension-table-header": "3.32.0",
    "@tiptap/extension-table-row": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/html": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/static-renderer": "3.32.0",
    "ai": "^7.0.163",
    "better-auth": "~1.7.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "convex-helpers": "^0.1.133",
    "lucide-react": "^1.68.0",
    "marked": "^18.1.3",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-image-crop": "^11.1.2",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@next/env": "16.4.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "axe-core": "4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "convex-test": "^0.0.67",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "glob": "^13.0.6",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-doctor": "0.9.18",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
