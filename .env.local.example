# You do not need to copy .env.local.example. On the first start, `pnpm dev`
# writes the Convex values, the three secrets and BETTER_AUTH_URL into
# .env.local. This file lists the names. It also works as a template for the
# by-hand steps in docs/starter/local-setup.md.

# ─── Required: Convex ───────────────────────────────────────
# `pnpm dev` writes these three on the first start.
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex HTTP-actions base URL (same host, ends with .convex.site).
# Required for Better Auth and server-side auth helpers.
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# ─── Required: Better Auth ──────────────────────────────────────────────────
# The public address of the app. On your computer it is http://localhost:3000.
# A hosted site uses its own address, for example https://example.com.
# Convex needs the same value. `pnpm dev` copies a local address to Convex.
BETTER_AUTH_URL=http://localhost:3000

# `pnpm dev` makes this secret. Use a new value for each site, and never
# commit a real value.
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32

# ─── Optional: On-demand revalidation ───────────────────────────────────────
# Shared secret between Convex and the Next.js /api/revalidate route.
# Publishing needs it to refresh cached pages. `pnpm dev` makes it.
REVALIDATE_SECRET=replace-with-openssl-rand-hex-32

# ─── Required: Public auth and contact IP proof ─────────────────────────────
# Shared secret between Next.js and Convex. Password reset fails closed without
# an exact pairing; contact and account-setup requests also use it to prove the
# Next-observed client identity. `pnpm dev` makes it and copies it to Convex.
CONTACT_IP_PROOF_SECRET=replace-with-openssl-rand-hex-32

# ─── Required for first owner: Convex env only ──────────────────────────────
# FORMULACMS_OWNER_CLAIM is the one-time owner setup code. It lives in Convex
# only. Never put it in this file, a URL or a command argument. `pnpm dev`
# makes it and shows it in the terminal until the site has an owner.

# ─── Optional: Public site URL ──────────────────────────────────────────────
# Used for canonical URLs and Open Graph. Defaults to localhost:3000 in dev.
# Set to http://localhost:3000 for local production-build verification and to
# your deployed origin for production (e.g. https://example.com).
NEXT_PUBLIC_SITE_URL=

# ─── Local verification only: private-network image optimization ──────────
# Next.js 16 blocks next/image optimization for local/private IPs by default.
# Set only while building a production-local verification server against local
# Convex storage URLs. Do not enable on public production deployments.
FORMULACMS_ALLOW_LOCAL_IMAGE_IPS=

# ─── Optional: production email via Convex env ───────────────────────────────
# Console fallback sends nothing and is not production-ready. The bundled
# Resend adapter reads its credential only from Convex deployment env; do not
# add the key to this file or enter it in Settings:
#   pnpm exec convex env set RESEND_API_KEY
# Then set sender identity, run the owner-restricted test, and activate Resend
# in Settings -> Email.

# AI is off by default; enable it in Settings > Modules, then open Settings > AI.
# Provider keys belong in the Convex environment, not this Next.js file:
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Block creator (local development only). Its key stays on this computer and
# is never sent to Convex. Add one of these to .env.local, then choose the
# provider under Settings > AI > Block creator:
# FORMULACMS_DEV_OPENROUTER_API_KEY=
# FORMULACMS_DEV_ANTHROPIC_API_KEY=
# FORMULACMS_DEV_OPENAI_API_KEY=
